{
	"name": "discord-countdown-bot",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "tsx watch src/index.ts",
    "start": "npm run build && node dist/src/index.js",
		"register-commands": "tsx src/register-commands.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
    "discord.js": "^14.16.3",
		"dotenv": "^16.4.7",
		"luxon": "^3.5.0",
		"sharp": "^0.33.5"
	},
	"devDependencies": {
    "@types/luxon": "^3.4.2",
		"@types/node": "^22.10.2",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
